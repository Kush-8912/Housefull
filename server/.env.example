NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/housefull
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
TICKET_SIGNING_SECRET=replace-with-a-different-long-random-string
CLIENT_ORIGIN=http://localhost:5173
HOLD_TTL_MINUTES=8
MAX_SEATS_PER_HOLD=8
# Booking fee % on tickets after discounts (18% GST is added on the fee)
BOOKING_FEE_PERCENT=5
# Public URL for links in emails (defaults to CLIENT_ORIGIN)
# APP_URL=https://your-app.onrender.com
# Outgoing email. Leave unset in development: emails are saved to server/.mail-outbox/
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Housefull <tickets@housefull.dev>

# Optional: "Continue with Google". Create an OAuth client ID (type: Web
# application) in Google Cloud console > APIs & Services > Credentials, with
# your site's origins as Authorized JavaScript origins. No secret is needed.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional: Claude writes the reminder emails sent the day before an event.
# Without it they use a built-in template. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=
